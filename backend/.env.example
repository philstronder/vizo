NODE_ENV=development
PORT=4000

# Local Postgres for development (docker compose up -d — see docker-compose.yml,
# published on 5433 to avoid colliding with any other local Postgres on 5432).
# For RDS, use the instance endpoint — see docs/aws-rds-setup.md — and set PGSSL=true.
DATABASE_URL=postgres://vizo:vizo@localhost:5433/vizo
PGSSL=false

# Generate with: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me

# Must match the frontend origin exactly (no trailing slash) for the
# httpOnly auth cookie to be accepted cross-origin in the browser.
# Comma-separate multiple origins, e.g. local dev plus the EC2 host.
CORS_ORIGIN=http://localhost:3000

# Mark the auth cookie Secure (HTTPS-only). Defaults to true when
# NODE_ENV=production; set to false while serving over plain http.
# COOKIE_SECURE=false
