{
  "name": "vizo-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:preview": "npx eas-cli@latest build --profile preview --platform all",
    "build:production": "npx eas-cli@latest build --profile production --platform all",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview",
    "update:production": "npx eas-cli@latest update --channel production --environment production"
  },
  "private": true
}
